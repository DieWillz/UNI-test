TEAM_COORDINATION.md
TASKS_FOR_MODELS.md
IDEA.md
MODEL_CARD
ALIASES
*.zip

# Dev coordinator runtime state and authenticated provider profiles
/.uni-dev/coordination/state.json
/.uni-dev/coordination/*.tmp
/.uni-dev/coordination/browser-profiles/

# Local config files and secrets
.uni-local/

# Local binaries / downloaded tools
uni/webui/bin/
*.exe
cloudflared
cloudflared.exe

# Reference binaries for voice cloning (kept locally)
uni/webui/text.wav
uni/webui/text.txt

# Hermes backup exclusions (privacy / secrets)
.uni-council-browser-profile/
.uni-backup-2026-08-08/
config-old.yml
config/
IDENTITY.md
SOUL.md
USER.md
TOOLS.md
HEARTBEAT.md
UNI-online-update.md
UNI-online-updated-by-Hermes.md
start-uni*.lnk
