   "icons": {
      "128": "icon.png",
      "16": "icon.png",
      "48": "icon.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "Stability Matrix CivitAI Integration",
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "1.0.7"
}
