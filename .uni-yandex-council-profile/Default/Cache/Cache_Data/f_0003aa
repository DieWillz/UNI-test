<script>
const $=s=>document.querySelector(s);
const el=(t,c)=>{const e=document.createElement(t);if(c)e.className=c;return e;};
const esc=s=>(s||"").replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));
const transportLabel=t=>t==="api"?"API":t==="codex"?"Codex CLI":"браузер · free";
const statusLabel=s=>({ready:"готов",configured:"настроен",unavailable:"недоступен",disabled:"отключён"}[s]||s||"неизвестно");
const TEMPLATES={
  concept:{topic:"Согласование концепции",brief:"Проверьте концепцию. Если согласны — поставьте подпись: Имя = ваша редакция; подписываюсь под концепцией."},
  audit:{topic:"Аудит кода",brief:"Проведите аудит предложенного кода. Найдите риски, уязвимости и что можно улучшить."},
  feature:{topic:"Разработка функции",brief:"Предложите реализацию функции. Опишите API, крайние случаи и тесты."},
  bug:{topic:"Поиск ошибки",brief:"Найдите причину ошибки в описанном сценарии и предложите фикс."},
  free:{topic:"Свободное задание",brief:"Опишите задачу свободно — что нужно сделать или обсудить."}
};
let AGENTS=[],EP_CONFIG={};
const state={};
let running=false;
let currentRound={id:null,synthesis:"",reportPath:null,signatures:{},errors:{}};
let reportViewing=false;
let newAnswersWhileViewing=0;
let autoMode="off"; // off | on | paused

async function loadParticipants(){
  try{const r=await fetch("/api/participants");AGENTS=await r.json();}catch(e){AGENTS=[];}
  AGENTS.forEach(a=>{if(!(a.name in state))state[a.name]={on:a.status!=="unavailable"&&a.status!=="disabled",status:statusLabel(a.status),answer:"",sig:"",via:a.transport,error:"",expanded:false,
    browserSetup:{enabled:(a.transport==="browser"),cdp:"—",tab:"—",auth:"—",url:(a.host?("https://"+a.host):"")},browserStage:""};});
  renderAgents();updateReadiness();
}
function renderAgents(){
  const wrap=$("#agents");wrap.innerHTML="";
  const pal=["oklch(70% 0.12 145)","oklch(72% 0.13 110)","oklch(70% 0.12 200)","oklch(74% 0.11 220)","oklch(72% 0.12 250)","oklch(70% 0.13 280)","oklch(78% 0.13 60)","oklch(75% 0.12 90)"];
  AGENTS.forEach((a,i)=>{const st=state[a.name]||{on:false,status:"configured"};
    const una=a.status==="unavailable"||a.status==="disabled";
    const card=el("div","agent "+(st.on?"on":"off")+(una?" unavailable":""));
    const av=el("div","avatar");av.style.background=pal[i%pal.length];av.textContent=a.name[0];
    const mid=el("div");
    const nm=el("div","a-name");nm.textContent=a.name;
    const rl=el("div","a-role");rl.textContent=a.role||"";
    const badge=el("span","badge "+a.transport);badge.textContent=transportLabel(a.transport);
    const stateLine=el("div","a-state");
    const stateTxt=una?`<span class="una">Недоступен</span>`:(st.on?`<span class="on">Включён</span>`:`<span class="off">Выключен</span>`);
    stateLine.innerHTML=stateTxt;
    mid.append(nm,rl,badge,stateLine);
    const ico=el("div","a-status-ico");ico.textContent=una?"⛔":(st.on?"🟢":"⚪");
    card.append(av,mid,ico);
    if(!una)card.onclick=()=>{if(state[a.name]){state[a.name].on=!state[a.name].on;renderAgents();updateReadiness();}};
    wrap.append(card);});
  const n=AGENTS.filter(a=>state[a.name]&&state[a.name].on).length;
  $("#agentCount").textContent=`${n}/${AGENTS.length} активны`;
}
function updateReadiness(){
  const total=AGENTS.length;
  const on=AGENTS.filter(a=>state[a.name]&&state[a.name].on).length;
  const una=AGENTS.filter(a=>a.status==="unavailable"||a.status==="disabled").length;
  const dis=AGENTS.filter(a=>state[a.name]&&!state[a.name].on&&a.status!=="unavailable"&&a.status!=="disabled").length;
  const list=AGENTS.map(a=>{const s=state[a.name];const tag=s&&s.on?"✓":(a.status==="unavailable"||a.status==="disabled"?"⛔":"○");return `${tag} ${a.name}`;}).join("  ");
  $("#readiness").innerHTML=`<b class="ok">Готовы: ${on}</b> · <b class="una">Недоступны: ${una}</b> · <b class="dis">Отключены: ${dis}</b><br>${esc(list)}`;
  updatePlan();
}

const files=[];
function renderFiles(){const wrap=$("#files");wrap.innerHTML="";files.forEach((f,i)=>{const c=el("div","filechip");
  const name=el("span");name.textContent="📄 "+f.name;const meta=el("span","meta");meta.textContent=`${Math.ceil(f.size/1024)} КБ`;
  const sync=el("span","sync");sync.textContent="✓ текст загружен";
  const x=el("span","x");x.textContent="✕";x.onclick=()=>{files.splice(i,1);renderFiles();};c.append(name,meta,sync,x);wrap.append(c);});}
async function addFiles(list){
  for(const file of list){
    if(files.length>=12){log("Максимум 12 файлов","warn");break;}
    if(file.size>300000){log(`${file.name}: файл больше 300 КБ`,"warn");continue;}
    if(files.some(f=>f.name===file.name)){log(`${file.name}: уже добавлен`,"warn");continue;}
    const content=await file.text();
    if(content.includes(String.fromCharCode(0))){log(`${file.name}: бинарный файл не поддерживается`,"warn");continue;}
    files.push({name:file.name,content,size:file.size});
  }
  renderFiles();updatePlan();
}
$("#drop").onclick=()=>$("#fileInput").click();
$("#fileInput").onchange=async e=>{await addFiles(e.target.files);e.target.value="";};
const drop=$("#drop");["dragover","dragenter"].forEach(ev=>drop.addEventListener(ev,e=>{e.preventDefault();drop.classList.add("hover");}));
["dragleave","drop"].forEach(ev=>drop.addEventListener(ev,e=>{e.preventDefault();drop.classList.remove("hover");}));
drop.addEventListener("drop",async e=>{await addFiles(e.dataTransfer.files);});

$("#template").onchange=()=>{const t=TEMPLATES[$("#template").value];if(t){$("#topic").value=t.topic;$("#brief").value=t.brief;updatePlan();}};
$("#topic").oninput=updatePlan;$("#brief").oninput=updatePlan;
function updatePlan(){
  const t=$("#topic").value.trim()||"(не задана)";
  const b=$("#brief").value.trim()||"(пусто)";
  const on=AGENTS.filter(a=>state[a.name]&&state[a.name].on);
  $("#planText").textContent=`Тема: ${t}\nБриф: ${b.slice(0,200)}${b.length>200?"…":""}\nУчастников: ${on.length} (${on.map(a=>a.name).join(", ")})`;
}

function log(msg,cls=""){
  const t=new Date().toLocaleTimeString("ru-RU");
  const html=`<span class="t">${t}</span> <span class="${cls||""}">${esc(msg)}</span>`;
  const targets=["#log","#logFull","#runHint"].map(sel=>$(sel)).filter(Boolean);
  if(!targets.length){console.log("[UNI]",msg);return;}
  targets.forEach((node,i)=>{
    if(node.id==="runHint"){node.textContent=msg;return;}
    const d=el("div");d.innerHTML=html;
    node.append(d);node.scrollTop=node.scrollHeight;
  });
}

function buildGrid(){
  const grid=$("#grid");grid.innerHTML="";
  const pal=["oklch(70% 0.12 145)","oklch(72% 0.13 110)","oklch(70% 0.12 200)","oklch(74% 0.11 220)","oklch(72% 0.12 250)","oklch(70% 0.13 280)","oklch(78% 0.13 60)","oklch(75% 0.12 90)"];
  let i=0;
  AGENTS.filter(a=>state[a.name]&&state[a.name].on).forEach(a=>{
    const box=el("div","mbox");box.dataset.name=a.name;
    const head=el("div","mhead");
    const av=el("div","mava");av.style.background=pal[i++%pal.length];av.textContent=a.name[0];
    const nm=el("div");const n1=el("div","mname");n1.textContent=a.name;const n2=el("div","mrole");n2.textContent=a.role;nm.append(n1,n2);
    const led=el("div","mled");led.dataset.led="1";
    head.append(av,nm,led);
    const body=el("div","mbody");body.dataset.body="1";
    const foot=el("div","mfoot");foot.dataset.foot="1";
    box.append(head,body,foot);grid.append(box);
    renderCardFromState(a.name);
  });
}
function renderCardFromState(name){
  const st=state[name];if(!st)return;
  const box=document.querySelector(`.mbox[data-name="${name}"]`);if(!box)return;
  setLed(name, st.status==="опрос…"?"run":st.error?"err":st.answer?"ok":"");
  const errHtml=st.error?`<div class="err">⚠ ${esc(st.error).slice(0,400)}</div>`:"";
  const sigHtml=st.sig?`<div class="sig"><b>Подпись ${name}:</b> ${esc(st.sig)}</div>`:"";
  const textHtml=st.answer?`<div>${esc(st.answer)}</div>`:`<div class="empty">${st.error?"нет ответа":"ожидает запуска. Транспорт: "+transportLabel(st.via)}</div>`;
  // browser stage block (placeholder until backend streams real stages)
  let stageHtml="";
  if(st.via==="browser"&&st.status!=="готов"){stageHtml=`<div class="stage"><span class="wait">${esc(st.browserStage||"ожидание браузерной сессии…")}</span></div>`;}
  const body=box.querySelector("[data-body]");
  body.innerHTML=textHtml+sigHtml+errHtml+stageHtml;
  body.classList.toggle("expanded",!!st.expanded);
  const foot=box.querySelector("[data-foot]");
  foot.innerHTML=`<span>${st.via}${st.latency?` · ${st.latency}s`:""}${st.error?" · ошибка":""}</span>`+
    (st.answer&&st.answer.length>500?`<span class="expand-btn" data-exp="${name}">${st.expanded?"Свернуть":"Развернуть"}</span>`:"");
  const eb=foot.querySelector("[data-exp]");
  if(eb)eb.onclick=()=>{st.expanded=!st.expanded;renderCardFromState(name);};
}
function setLed(name,cls){const box=document.querySelector(`.mbox[data-name="${name}"]`);if(!box)return;
  box.className="mbox "+(cls==="run"?"run":cls==="ok"?"ok":cls==="err"?"err":"");
  box.querySelector("[data-led]").className="mled "+cls;}

async function runRound(opts={}){
  if(running)return;
  const apiOnly=!!opts.apiOnly;
  const enabled=AGENTS.filter(a=>{
    if(!(state[a.name]&&state[a.name].on))return false;
    if(apiOnly&&a.transport==="browser")return false;
    return true;
  }).map(a=>a.name);
  if(!$("#topic").value.trim()){log("Укажите тему раунда","warn");return;}
  if(!enabled.length){log("Включите хотя бы одного доступного участника","warn");return;}
  const hasBrowser=enabled.some(name=>AGENTS.find(a=>a.name===name)?.transport==="browser");
  const tosAck=hasBrowser && localStorage.getItem("uni_tos_ack")==="1";
  if(hasBrowser && !tosAck){log("ToS не подтверждён — браузерные участники пропущены. Включите их в настройках или используйте «Только API».","warn");}
  running=true;[ $("#runBtn"),$("#runBtn2"),$("#runApiBtn"),$("#rollCallBtn"),$("#checkBtn") ].forEach(b=>b&&(b.disabled=true));
  $("#progress").classList.add("show");
  $("#summary").style.display="none";$("#summaryDot").classList.remove("show");
  $("#preRound").style.display="none";$("#gridWrap").style.display="block";
  AGENTS.forEach(a=>{if(state[a.name]){state[a.name].answer="";state[a.name].sig="";state[a.name].error="";state[a.name].status="готов";state[a.name].expanded=false;}});
  currentRound={id:null,synthesis:"",reportPath:null,signatures:{},errors:{}};
  buildGrid();
  const attachments=Object.fromEntries(files.map(f=>[f.name,f.content]));
  const payload={topic:$("#topic").value.trim(),brief:$("#brief").value,files:attachments,tasks:[],only:enabled,enabled};
  $("#roundId").textContent="run…";log(`Старт раунда · участников: ${enabled.length}${hasBrowser && !tosAck?" (браузерные пропущены)":""}`);
  try{
    const res=await fetch("/api/round/start",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(payload)});
    if(!res.ok){const body=await res.json().catch(()=>({}));throw new Error(body.error||`HTTP ${res.status}`);}
    const reader=res.body.getReader();const dec=new TextDecoder();let buf="";
    while(true){const{done,value}=await reader.read();if(done)break;
      buf+=dec.decode(value,{stream:true});let idx;
      while((idx=buf.indexOf("\n\n"))>=0){const chunk=buf.slice(0,idx);buf=buf.slice(idx+2);
        const line=chunk.split("\n").find(l=>l.startsWith("data: "));if(!line)continue;
        handleEvent(JSON.parse(line.slice(6)));}}
  }catch(e){log("Ошибка соединения: "+e.message,"warn");}
  finally{running=false;[ $("#runBtn"),$("#runBtn2"),$("#runApiBtn"),$("#rollCallBtn"),$("#checkBtn") ].forEach(b=>b&&(b.disabled=false));$("#progress").classList.remove("show");}
}
function handleEvent(ev){
  switch(ev.type){
    case"init":log(`Участники: ${ev.participants.map(p=>p.name).join(", ")}`,"ok");break;
    case"start":break;
    case"participant_start":setLed(ev.name,"run");if(state[ev.name])state[ev.name].status="опрос…";
      state[ev.name].error="";if(state[ev.name].via==="browser"&&ev.stage)state[ev.name].browserStage=ev.stage;renderCardFromState(ev.name);log(`→ ${ev.name} [${ev.via}] запрос отправлен`);break;
    case"participant_done":{
      if(state[ev.name]){state[ev.name].answer=ev.text||"";state[ev.name].sig=ev.signature||"";state[ev.name].status=ev.ok?"готов":"ошибка";state[ev.name].error=ev.error||"";state[ev.name].via=ev.via;state[ev.name].latency=ev.latency;}
      renderCardFromState(ev.name);
      updateSigCount();
      log(`← ${ev.name} ответ${ev.ok?"":" (ошибка)"}${ev.signature?" + подпись":""}`,ev.ok?"ok":"warn");
      if(reportViewing){newAnswersWhileViewing++;showNotify(`Новый ответ: ${ev.name}`);}
      break;}
    case"done":{currentRound.id=ev.round_id;currentRound.synthesis=ev.synthesis||"";currentRound.reportPath=ev.report_path||null;
      currentRound.signatures=ev.signatures||{};currentRound.errors=ev.errors||{};
      $("#roundId").textContent=ev.round_id||"—";
      log("Раунд завершён · отчёт: "+(ev.report_path||"—"),"ok");
      $("#summaryText").textContent=ev.synthesis||"Общая сводка не создана; откройте полный отчёт.";
      $("#summary").style.display="block";$("#summaryDot").classList.add("show");
      $("#summaryFull").innerHTML=`<div style="white-space:pre-wrap;line-height:1.6">${esc(ev.synthesis||"(пусто)")}</div>`;
      $("#runHint").textContent="Готово · отчёт в "+(ev.report_path||".uni-council/");loadHistory();break;}
    case"error":log("Ошибка: "+(ev.msg||"?"),"warn");break;
  }
}

function updateSigCount(){const total=AGENTS.filter(a=>state[a.name]&&state[a.name].on).length;
  const got=AGENTS.filter(a=>state[a.name]&&state[a.name].on&&state[a.name].sig).length;
  $("#sigCount").textContent=`${got}/${total}`;}

