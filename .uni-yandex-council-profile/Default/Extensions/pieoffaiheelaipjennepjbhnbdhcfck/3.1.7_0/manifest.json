   "icons": {
      "128": "icons/AnonVPN128.png",
      "16": "icons/AnonVPN16.png",
      "256": "icons/AnonVPN256.png",
      "32": "icons/AnonVPN32.png",
      "48": "icons/AnonVPN48.png",
      "512": "icons/AnonVPN512.png",
      "64": "icons/AnonVPN64.png"
   },
   "key": "",
   "manifest_version": 3,
   "minimum_chrome_version": "109",
   "name": "__MSG_extName__",
   "offline_enabled": true,
   "optional_permissions": [ "management", "webNavigation" ],
   "permissions": [ "proxy", "storage", "alarms", "webRequest", "webRequestAuthProvider", "declarativeNetRequest", "offscreen", "notifications" ],
   "short_name": "AnonVPN",
   "update_url": "https://clients2.google.com/service/update2/crx",
