<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>UNI · Консоль разработки</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;650&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  /* ---------------------------------------------------------------------
     UNI console — instrument-panel design language.
     Warm graphite base (not the default purple-grey dark-mode), a single
     amber signal color borrowed from cockpit/terminal instrumentation,
     Space Grotesk for the wordmark & section labels, Inter for reading,
     JetBrains Mono for anything that is data (ids, timestamps, logs).
     All class names below are unchanged from the previous version —
     only appearance, spacing and elevation were redesigned.
  --------------------------------------------------------------------- */
  :root{
    --bg:oklch(15.5% 0.008 75);--bg-2:oklch(18.5% 0.010 75);--panel:oklch(21.5% 0.012 75);
    --panel-2:oklch(25.5% 0.014 75);--ink:oklch(96% 0.004 75);--muted:oklch(69% 0.016 75);
    --faint:oklch(48% 0.016 75);--line:oklch(30% 0.013 75);--line-soft:oklch(26% 0.012 75);

    --accent:oklch(80% 0.15 63);--accent-ink:oklch(18% 0.03 63);
    --accent-2:oklch(74% 0.12 218);--browser:oklch(74% 0.12 218);
    --api:oklch(79% 0.15 150);--ok:oklch(79% 0.15 150);
    --danger:oklch(68% 0.19 25);--warn:oklch(82% 0.15 85);

    --radius-lg:14px;--radius:11px;--r-sm:8px;--r-xs:6px;
    --shadow-sm:0 1px 2px rgba(0,0,0,.35);
    --shadow-md:0 6px 20px -4px rgba(0,0,0,.5);
    --shadow-lg:0 20px 60px -12px rgba(0,0,0,.6);
    --ease:cubic-bezier(.2,.7,.3,1);

    --display:"Space Grotesk",var(--sans);
    --mono:"JetBrains Mono",ui-monospace,"SFMono-Regular",Menlo,Consolas,monospace;
    --sans:"Inter",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  }
  *{box-sizing:border-box}
  html,body{height:100%;margin:0}
  body{
    background:
      radial-gradient(1200px 600px at 12% -10%, color-mix(in oklch, var(--accent) 5%, transparent), transparent 60%),
      var(--bg);
    color:var(--ink);font-family:var(--sans);font-size:13px;line-height:1.5;
    display:flex;flex-direction:column;overflow:hidden;
    -webkit-font-smoothing:antialiased;
  }
  button,input,textarea,select{font-family:inherit;font-size:inherit;color:inherit}
  ::selection{background:color-mix(in oklch,var(--accent) 35%,transparent);color:var(--ink)}
  :focus-visible{outline:2px solid color-mix(in oklch,var(--accent) 70%,transparent);outline-offset:2px;border-radius:4px}

  /* ---- topbar --------------------------------------------------------- */
  .topbar{display:flex;align-items:center;gap:10px;padding:10px 16px;background:var(--bg-2);
    border-bottom:1px solid var(--line-soft);flex-wrap:wrap}
  .brand{display:flex;align-items:center;gap:9px;font-family:var(--display);font-weight:600;
    letter-spacing:.01em;white-space:nowrap;font-size:14.5px}
  .brand .dot{position:relative;width:9px;height:9px;border-radius:50%;background:var(--accent);
    box-shadow:0 0 0 3px color-mix(in oklch,var(--accent) 18%,transparent),0 0 10px color-mix(in oklch,var(--accent) 70%,transparent)}
  .brand .dot::after{content:"";position:absolute;inset:-6px;border-radius:50%;
    border:1px solid color-mix(in oklch,var(--accent) 45%,transparent);animation:radar 2.4s var(--ease) infinite}
  @keyframes radar{0%{transform:scale(.4);opacity:.9}100%{transform:scale(2.1);opacity:0}}
  .brand small{color:var(--faint);font-weight:500;font-size:11px;font-family:var(--sans);letter-spacing:0}
  .topbar .spacer{flex:1}
  .pill{display:inline-flex;align-items:center;gap:6px;padding:4.5px 10px;border:1px solid var(--line);
    border-radius:999px;font-size:11px;color:var(--muted);background:var(--panel);white-space:nowrap;font-family:var(--mono)}
  .pill b{color:var(--ink);font-weight:600}
  .pill .led{width:6px;height:6px;border-radius:50%;background:var(--ok);box-shadow:0 0 6px color-mix(in oklch,var(--ok) 80%,transparent)}
  .gate-chip{display:inline-flex;align-items:center;gap:6px;padding:4.5px 10px;border:1px solid color-mix(in oklch,var(--ok) 30%,var(--line));
    border-radius:999px;font-size:10.5px;color:var(--ok);background:color-mix(in oklch,var(--ok) 8%,transparent);cursor:default}
  .gate-chip::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--ok);box-shadow:0 0 6px color-mix(in oklch,var(--ok) 80%,transparent)}

  .btn{border:1px solid var(--line);background:var(--panel);color:var(--ink);padding:7.5px 13px;
    border-radius:var(--r-sm);cursor:pointer;transition:.15s var(--ease);white-space:nowrap;font-weight:500;
    box-shadow:var(--shadow-sm)}
  .btn:hover{background:var(--panel-2);border-color:var(--faint);transform:translateY(-1px)}
  .btn:active{transform:translateY(0)}
  .btn.primary{background:var(--accent);color:var(--accent-ink);border-color:transparent;font-weight:650;
    box-shadow:0 4px 16px -4px color-mix(in oklch,var(--accent) 60%,transparent)}
  .btn.primary:hover{filter:brightness(1.05);transform:translateY(-1px)}
  .btn:disabled{opacity:.45;cursor:not-allowed;transform:none;box-shadow:none}
  .btn.sm{padding:5.5px 10px;font-size:11.5px}

  /* ---- layout ----------------------------------------------------------- */
  .layout{flex:1;display:grid;grid-template-columns:266px 1fr;min-height:0}
  .col{min-height:0;display:flex;flex-direction:column;overflow:hidden}
  .col.left{border-right:1px solid var(--line-soft);background:var(--bg-2)}
  .col-head{padding:13px 14px 8px;font-size:10.5px;text-transform:uppercase;letter-spacing:.12em;
    color:var(--faint);font-weight:600;display:flex;align-items:center;justify-content:space-between}
  .col-body{flex:1;overflow-y:auto;padding:0 12px 14px}
  .col-body::-webkit-scrollbar,.gridwrap::-webkit-scrollbar,.report-body::-webkit-scrollbar{width:9px}
  .col-body::-webkit-scrollbar-thumb,.gridwrap::-webkit-scrollbar-thumb,.report-body::-webkit-scrollbar-thumb{
    background:var(--line);border-radius:9px;border:2px solid transparent;background-clip:padding-box}

  .agent{display:grid;grid-template-columns:34px 1fr;gap:10px;align-items:center;padding:10px;
    background:var(--panel);border:1px solid var(--line-soft);border-radius:var(--radius);margin-bottom:7px;
    transition:.15s var(--ease);cursor:pointer}
  .agent:hover{border-color:var(--faint)}
  .agent.on{border-color:color-mix(in oklch,var(--accent) 40%,var(--line));box-shadow:0 0 0 1px color-mix(in oklch,var(--accent) 12%,transparent) inset}
  .agent.off{opacity:.55}
  .agent.unavailable{opacity:.5;cursor:not-allowed;background:color-mix(in oklch,var(--danger) 6%,var(--panel))}
  .avatar{width:34px;height:34px;border-radius:9px;display:grid;place-items:center;font-weight:700;
    font-size:12px;color:oklch(18% 0.02 75);font-family:var(--display);box-shadow:var(--shadow-sm)}
  .a-name{font-weight:600;font-size:12.5px}.a-role{color:var(--muted);font-size:10.5px;margin-top:1px}
  .badge{font-family:var(--mono);font-size:9px;padding:2px 6px;border-radius:5px;letter-spacing:.03em;margin-top:4px;display:inline-block;font-weight:500}
  .badge.api{background:color-mix(in oklch,var(--api) 16%,transparent);color:var(--api);border:1px solid color-mix(in oklch,var(--api) 38%,transparent)}
  .badge.browser{background:color-mix(in oklch,var(--browser) 15%,transparent);color:var(--browser);border:1px solid color-mix(in oklch,var(--browser) 36%,transparent)}
  .badge.codex{background:color-mix(in oklch,var(--accent) 15%,transparent);color:var(--accent);border:1px solid color-mix(in oklch,var(--accent) 36%,transparent)}
  .a-state{font-family:var(--mono);font-size:10px;margin-top:5px}
  .a-state .on{color:var(--ok)}.a-state .off{color:var(--faint)}.a-state .una{color:var(--danger)}
  .a-status-ico{margin-left:auto;font-size:11px}

  /* ---- center: brief / rounds ------------------------------------------ */
  .center{display:flex;flex-direction:column;overflow:hidden}
  .briefwrap{padding:14px 16px 10px;border-bottom:1px solid var(--line-soft);background:var(--bg-2)}
  .field{margin-bottom:10px}
  .field label{display:block;font-size:10.5px;text-transform:uppercase;letter-spacing:.1em;color:var(--faint);
    margin-bottom:5px;font-weight:600}
  .topic-input,.brief{width:100%;background:var(--panel);border:1px solid var(--line);border-radius:var(--r-sm);
    padding:9px 11px;color:var(--ink);resize:vertical;outline:none;transition:.15s var(--ease)}
  .topic-input:hover,.brief:hover{border-color:var(--faint)}
  .topic-input:focus,.brief:focus{border-color:var(--accent);box-shadow:0 0 0 3px color-mix(in oklch,var(--accent) 16%,transparent)}
  .brief{min-height:76px;font-family:var(--mono);font-size:12px;line-height:1.55}
  .row{display:flex;gap:9px;align-items:center;flex-wrap:wrap}
  .drop{border:1.5px dashed var(--line);border-radius:var(--r-sm);padding:11px;text-align:center;color:var(--muted);
    transition:.15s var(--ease);cursor:pointer;font-size:12px;background:color-mix(in oklch,var(--panel) 40%,transparent)}
  .drop:hover{border-color:var(--faint);color:var(--ink)}
  .drop.hover{border-color:var(--accent);color:var(--ink);background:color-mix(in oklch,var(--accent) 8%,transparent)}
  .files{margin-top:7px;display:flex;flex-direction:column;gap:5px}
  .filechip{display:flex;align-items:center;gap:8px;padding:6px 9px;background:var(--panel);border:1px solid var(--line-soft);
    border-radius:var(--r-sm);font-size:12px}
  .filechip .sync{margin-left:auto;font-family:var(--mono);font-size:10px;color:var(--ok)}
  .filechip .x{cursor:pointer;color:var(--faint);padding:0 3px;transition:.12s}.filechip .x:hover{color:var(--danger)}
  .actions-bar{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin:3px 0 4px}
  .progress{flex:1;min-width:80px;height:6px;background:var(--line);border-radius:999px;overflow:hidden;display:none}
  .progress.show{display:block}
  .progress>i{display:block;height:100%;width:0%;
    background:linear-gradient(90deg,var(--accent),color-mix(in oklch,var(--accent) 60%,var(--accent-2)));
    transition:width .3s var(--ease)}

  .autobar{display:flex;align-items:center;gap:12px;padding:8px 16px;background:var(--bg-2);
    border-bottom:1px solid var(--line-soft);font-size:12px;flex-wrap:wrap}
  .autobar .state{color:var(--muted)}
  .autobar .state b{color:var(--ink);font-weight:600}
  .autobar .cycle{color:var(--faint);font-family:var(--mono);font-size:10.5px}

  .readiness{padding:8px 16px;background:var(--panel);border-bottom:1px solid var(--line-soft);
    font-family:var(--mono);font-size:11px;color:var(--muted)}
  .readiness b{color:var(--ink)}
  .readiness .ok{color:var(--ok)}.readiness .una{color:var(--danger)}.readiness .dis{color:var(--faint)}

  /* ---- tabs --------------------------------------------------------- */
  .tabs{display:flex;gap:2px;padding:8px 16px 0;border-bottom:1px solid var(--line-soft);background:var(--bg-2)}
  .tab{padding:8px 14px;border:1px solid transparent;border-bottom:none;border-radius:9px 9px 0 0;
    cursor:pointer;color:var(--muted);font-weight:600;font-size:12.5px;position:relative;transition:.15s var(--ease)}
  .tab:hover{color:var(--ink)}
  .tab.active{background:var(--bg);color:var(--ink);border-color:var(--line-soft)}
  .tab.active::after{content:"";position:absolute;left:10px;right:10px;bottom:-1px;height:2px;background:var(--accent);border-radius:2px 2px 0 0}
  .tab .badge-dot{position:absolute;top:3px;right:3px;min-width:15px;height:15px;border-radius:999px;
    background:var(--accent);color:var(--accent-ink);font-size:9px;font-weight:700;display:none;align-items:center;justify-content:center;padding:0 4px}
  .tab .badge-dot.show{display:flex}

  .tabpane{display:none;flex:1;min-height:0;overflow-y:auto}
  .tabpane.active{display:flex;flex-direction:column}
  #paneCurrent{padding:12px 14px}
  .gridwrap{flex:1;overflow-y:auto;padding:12px 14px}
  .msgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:11px;align-items:start}
  .mbox{background:var(--panel);border:1px solid var(--line-soft);border-radius:var(--radius);
    display:flex;flex-direction:column;overflow:hidden;transition:.2s var(--ease);box-shadow:var(--shadow-sm)}
  .mbox.run{border-color:color-mix(in oklch,var(--accent) 55%,var(--line));box-shadow:0 0 0 1px color-mix(in oklch,var(--accent) 28%,transparent),var(--shadow-md)}
  .mbox.err{border-color:color-mix(in oklch,var(--danger) 45%,var(--line))}
  .mbox.ok{border-color:color-mix(in oklch,var(--ok) 40%,var(--line))}
  .mhead{display:flex;align-items:center;gap:9px;padding:9px 11px;border-bottom:1px solid var(--line-soft);background:var(--bg-2)}
  .mava{width:26px;height:26px;border-radius:8px;display:grid;place-items:center;font-weight:700;font-size:11px;
    color:oklch(18% 0.02 75);font-family:var(--display)}
  .mname{font-weight:600;font-size:12.5px}.mrole{color:var(--muted);font-size:10px}
  .mled{margin-left:auto;width:9px;height:9px;border-radius:50%;background:var(--faint);flex:none}
  .mled.run{background:var(--accent);box-shadow:0 0 8px color-mix(in oklch,var(--accent) 70%,transparent);animation:pulse 1.1s infinite}
  .mled.ok{background:var(--ok);box-shadow:0 0 8px color-mix(in oklch,var(--ok) 60%,transparent)}
  .mled.err{background:var(--danger);box-shadow:0 0 8px color-mix(in oklch,var(--danger) 60%,transparent)}
  @keyframes pulse{0%,100%{opacity:1}50%{opacity:.35}}
  .mbody{flex:1;padding:11px;overflow-y:auto;font-size:12.5px;line-height:1.6;white-space:pre-wrap;word-break:break-word;max-height:230px}
  .mbody.expanded{max-height:none}
  .mbody::-webkit-scrollbar{width:8px}.mbody::-webkit-scrollbar-thumb{background:var(--line);border-radius:8px}
  .mbody .sig{margin-top:10px;padding:8px 10px;border-left:3px solid var(--accent);
    background:color-mix(in oklch,var(--accent) 8%,transparent);border-radius:0 7px 7px 0;font-size:12px}
  .mbody .sig b{color:var(--accent)}
  .mbody .err{color:var(--danger)}
  .mbody .empty{color:var(--faint);font-style:italic}
  .mbody .stage{font-size:10.5px;color:var(--muted);margin-top:7px;padding:5px 8px;background:var(--bg);
    border-radius:var(--r-xs);border:1px solid var(--line-soft)}
  .mbody .stage .done{color:var(--ok)}.mbody .stage .wait{color:var(--warn)}
  .mfoot{font-family:var(--mono);font-size:10px;color:var(--faint);padding:6px 11px;border-top:1px solid var(--line-soft);
    display:flex;justify-content:space-between;align-items:center;gap:8px}
  .expand-btn{cursor:pointer;color:var(--accent);font-size:10px;border:1px solid var(--line);border-radius:var(--r-xs);
    padding:2px 7px;transition:.12s}
  .expand-btn:hover{background:var(--panel-2);border-color:var(--accent)}

  .summary{margin:12px 14px 0;padding:13px 14px;background:var(--panel);border:1px solid var(--line-soft);
    border-left:3px solid var(--ok);border-radius:var(--r-sm);white-space:pre-wrap;box-shadow:var(--shadow-sm)}
  .summary h3{font-size:12px;margin:0 0 7px;font-family:var(--display);font-weight:600}
  .summary .actions{margin-top:9px;display:flex;gap:7px}
  .summary .hint{color:var(--faint);font-size:11px;margin-top:6px}

  .preround{margin:12px 14px;padding:14px;background:var(--panel);border:1px solid var(--line-soft);border-radius:var(--r-sm)}
  .preround h3{margin:0 0 8px;font-size:12.5px;font-family:var(--display);font-weight:600}
  .preround .plan{font-size:12px;color:var(--muted);white-space:pre-wrap;max-height:160px;overflow-y:auto}
  .preround .hint{margin-top:9px;color:var(--accent);font-size:11.5px}

  .log{font-family:var(--mono);font-size:10.5px;color:var(--muted);background:var(--bg);border:1px solid var(--line-soft);
    border-radius:var(--r-sm);padding:8px;max-height:100%;overflow-y:auto;min-height:120px}
  .log div{padding:1.5px 0}.log .t{color:var(--faint)}.log .ok{color:var(--ok)}.log .warn{color:var(--warn)}

  .history-tools{display:flex;gap:7px;align-items:center;padding:9px 12px;border-bottom:1px solid var(--line-soft);flex-wrap:wrap}
  .history-tools input,.history-tools select{background:var(--panel);border:1px solid var(--line);border-radius:var(--r-xs);
    padding:6px 9px;color:var(--ink);font-size:11.5px}
  .history{display:flex;flex-direction:column;gap:6px;padding:11px 12px}
  .history-item{padding:9px;background:var(--panel);border:1px solid var(--line-soft);border-radius:var(--r-sm);
    cursor:pointer;position:relative;transition:.15s var(--ease)}
  .history-item:hover{border-color:var(--faint);transform:translateX(2px)}
  .history-item b{display:block;font-size:11.5px;padding-right:22px;font-weight:600}
  .history-item span{font-size:10px;color:var(--muted);font-family:var(--mono)}
  .history-item .del{position:absolute;top:7px;right:7px;cursor:pointer;color:var(--faint);font-size:13px;line-height:1;transition:.12s}
  .history-item .del:hover{color:var(--danger)}
  .history-item .ok{color:var(--ok)}.history-item .err{color:var(--danger)}

  /* ---- drawers / modal / notification ------------------------------- */
  .drawer{position:fixed;top:0;right:0;height:100vh;width:min(680px,94vw);background:var(--bg-2);
    border-left:1px solid var(--line-soft);box-shadow:var(--shadow-lg);transform:translateX(100%);
    transition:transform .28s var(--ease);z-index:60;display:flex;flex-direction:column}
  .drawer.show{transform:translateX(0)}
  .drawer-head{display:flex;align-items:center;gap:11px;padding:13px 16px;border-bottom:1px solid var(--line-soft);background:var(--bg)}
  .drawer-head h3{margin:0;font-size:14px;flex:1;font-family:var(--display);font-weight:600}
  .drawer-body{flex:1;overflow-y:auto;padding:16px 18px}
  .report-body{font-size:13px;line-height:1.65;white-space:pre-wrap;word-break:break-word;
    background:var(--bg);border:1px solid var(--line-soft);border-radius:var(--r-sm);padding:14px;
    max-height:calc(100vh - 150px);overflow-y:auto}
  .report-body h1,.report-body h2,.report-body h3{color:var(--ink);font-family:var(--display)}
  .drawer .close{font-size:19px;line-height:1;cursor:pointer;color:var(--muted);padding:4px 9px;border-radius:var(--r-xs);transition:.12s}
  .drawer .close:hover{background:var(--panel-2);color:var(--ink)}
  .drawer .back{cursor:pointer;border:1px solid var(--line);background:var(--panel);color:var(--ink);
    padding:6.5px 12px;border-radius:var(--r-sm);font-size:12px;transition:.15s var(--ease)}
  .drawer .back:hover{background:var(--panel-2);border-color:var(--faint)}

  .notification{position:fixed;bottom:18px;left:50%;transform:translateX(-50%) translateY(0);z-index:70;
    background:var(--panel-2);border:1px solid var(--accent);color:var(--ink);padding:10px 16px;border-radius:var(--radius);
    box-shadow:var(--shadow-lg);display:none;align-items:center;gap:12px;cursor:pointer;font-size:12.5px}
  .notification.show{display:flex;animation:rise .25s var(--ease)}
  @keyframes rise{from{opacity:0;transform:translateX(-50%) translateY(8px)}to{opacity:1;transform:translateX(-50%) translateY(0)}}

  .modal{position:fixed;inset:0;background:oklch(10% 0.005 75 / 62%);backdrop-filter:blur(3px);
    display:none;align-items:center;justify-content:center;z-index:50}
  .modal.show{display:flex;animation:fade .18s var(--ease)}
  @keyframes fade{from{opacity:0}to{opacity:1}}
  .modal-box{width:min(620px,94vw);max-height:90vh;display:flex;flex-direction:column;background:var(--bg-2);
    border:1px solid var(--line-soft);border-radius:var(--radius-lg);overflow:hidden;box-shadow:var(--shadow-lg)}
  .modal-box h3{margin:0;padding:17px 20px 5px;font-size:15px;font-family:var(--display);font-weight:600}
  .modal-box .sub{color:var(--muted);font-size:12px;padding:0 20px 12px;line-height:1.5}
  .modal-tabs{display:flex;gap:4px;padding:0 16px;border-bottom:1px solid var(--line-soft);flex-wrap:wrap}
  .modal-tab{padding:9px 13px;cursor:pointer;color:var(--muted);font-weight:600;font-size:12px;
    border-bottom:2px solid transparent;transition:.15s var(--ease)}
  .modal-tab:hover{color:var(--ink)}
  .modal-tab.active{color:var(--ink);border-bottom-color:var(--accent)}
  .modal-body{flex:1;overflow-y:auto;padding:15px 20px}
  .opt{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 0;border-top:1px solid var(--line-soft)}
  .opt:first-child{border-top:none}
  .opt label{font-weight:500}
  .opt .hint{color:var(--faint);font-size:11px;margin-top:2px}
  .opt input[type=number]{width:82px;background:var(--panel);border:1px solid var(--line);border-radius:var(--r-xs);
