// Roll-call: prefer API participants; fall back to clear guidance (browser needs full round + CDP)
async function runRollCall(){
  if(running)return;
  const apiOn=AGENTS.filter(a=>state[a.name]&&state[a.name].on&&a.transport!=="browser").map(a=>a.name);
  const browserOn=AGENTS.filter(a=>state[a.name]&&state[a.name].on&&a.transport==="browser").map(a=>a.name);
  if(!apiOn.length){
    log("Перекличка ходит только по API (Gemini/Groq/OpenRouter/Hermes…). Сейчас включены в основном браузерные.","warn");
    if(browserOn.length){
      log("Для DeepSeek/QWEN/Claude/Grok: открой вкладки + CDP (порт 9222) и жми «Запустить раунд», не Перекличку.","warn");
    }else{
      log("Включите хотя бы одного API-участника слева или задайте ключи в Настройках → API.","warn");
    }
    // Soft health check so UI still does something useful
    try{await checkParticipants();}catch(_){}
    return;
  }
  running=true;[ $("#runBtn"),$("#runBtn2"),$("#runApiBtn"),$("#rollCallBtn"),$("#checkBtn") ].forEach(b=>b&&(b.disabled=true));
  if($("#preRound"))$("#preRound").style.display="none";
  if($("#gridWrap")){$("#gridWrap").style.display="block";buildGrid();}
  log("🔔 Перекличка · API: "+apiOn.join(", "));
  const payload={only:apiOn,enabled:apiOn};
  const brief="Ты — участник совета разработки проекта UNI. Ответь МАКСИМАЛЬНО КРАТКО (одна короткая фраза до 12 слов): подтверди, что ты на связи и подключён к работе над Юни, и укажи ТЕКУЩЕЕ ВРЕМЯ ПО МОСКВЕ (UTC+3) в формате ЧЧ:ММ. Например: 'Всё ок, Hermes на связи. Москва 14:32.'. Без лишних пояснений.";
  try{
    const res=await fetch("/api/round/start",{method:"POST",headers:{"Content-Type":"application/json"},
      body:JSON.stringify({...payload,topic:"Перекличка",brief,tasks:[]})});
    if(!res.ok){const b=await res.json().catch(()=>({}));throw new Error(b.error||`HTTP ${res.status}`);}
    const reader=res.body.getReader();const dec=new TextDecoder();let buf="";
    while(true){const{done,value}=await reader.read();if(done)break;
      buf+=dec.decode(value,{stream:true});let idx;
      while((idx=buf.indexOf("\n\n"))>=0){const chunk=buf.slice(0,idx);buf=buf.slice(idx+2);
        const line=chunk.split("\n").find(l=>l.startsWith("data: "));if(!line)continue;
        try{handleEvent(JSON.parse(line.slice(6)));}catch(err){log("SSE parse: "+err.message,"warn");}}}
  }catch(e){log("Ошибка переклички: "+e.message,"warn");}
  finally{[ $("#runBtn"),$("#runBtn2"),$("#runApiBtn"),$("#rollCallBtn"),$("#checkBtn") ].forEach(b=>b&&(b.disabled=false));running=false;}
}
// Participant health check (reads /api/participants, no round started)
async function checkParticipants(){
  log("Проверка участников…","ok");
  try{const r=await fetch("/api/participants");const list=await r.json();
    const ready=list.filter(a=>a.status==="ready"||a.status==="configured").length;
    const una=list.filter(a=>a.status==="unavailable"||a.status==="disabled").length;
    log(`Готовы/настроены: ${ready} · Недоступны: ${una}`,"ok");
    list.forEach(a=>log(`  ${a.name}: ${a.status}${a.detail?" ("+a.detail+")":""}`,a.status==="unavailable"?"warn":""));
  }catch(e){log("Ошибка проверки: "+e.message,"warn");}
}

