{
   "action": {
      "default_title": "Better DeepSeek"
   },
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [ {
      "css": [ "content.css" ],
      "js": [ "content.js" ],
      "matches": [ "https://chat.deepseek.com/*" ],
      "run_at": "document_start"
   } ],
   "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self'",
      "sandbox": "sandbox allow-scripts allow-forms allow-popups; script-src 'self' 'unsafe-eval' 'unsafe-inline' blob:; object-src 'self'"
   },
   "description": "Enhanced UX layer for DeepSeek with hidden prompts, tools, memory, document generation, and long-work packaging.",
   "host_permissions": [ "https://chat.deepseek.com/*", "https://codeload.github.com/*", "https://cdn.jsdelivr.net/*", "https://pyscript.net/*", "\u003Call_urls>" ],
   "key": "",
   "manifest_version": 3,
   "name": "Better DeepSeek",
   "permissions": [ "storage" ],
   "sandbox": {
      "pages": [ "sandbox.html" ]
   },
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "0.1.11",
   "web_accessible_resources": [ {
      "matches": [ "https://chat.deepseek.com/*" ],
      "resources": [ "injected.js", "sandbox.html", "sandbox.js", "static/loading/*.svg" ]
   } ]
}
