/* UNI Desktop Companion — renderer/style.css (Hermes SOLO, 2026-08-11, блок D) */
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body {
  width: 100%; height: 100%;
  background: transparent;       /* прозрачный оверлей */
  font: 13px/1.45 "Segoe UI", system-ui, sans-serif;
  color: #e8edf2; overflow: hidden; user-select: none;
}
#root { position: relative; width: 100%; height: 100%; }

/* D-03: кликабельные зоны перехватывают мышь; пустые — сквозь (main.js setIgnoreMouseEvents) */
#toolbar {
  position: absolute; top: 8px; left: 8px; right: 8px; display: flex; gap: 6px; z-index: 10;
}
.rbtn {
  width: 34px; height: 34px; border-radius: 50%; border: 1px solid rgba(255,255,255,.25);
  background: rgba(20,26,34,.78); color: #e8edf2; cursor: pointer; font-size: 15px; backdrop-filter: blur(6px);
}
.rbtn:hover { border-color: #c4e534; }
.rbtn.danger { color: #ff6b6b; border-color: rgba(255,107,107,.5); }

/* D-05: чат слева */
#chatPanel {
  position: absolute; left: 8px; top: 52px; bottom: 8px; width: 320px; z-index: 9;
  background: rgba(16,21,27,.82); border: 1px solid rgba(255,255,255,.12);
  border-radius: 12px; display: flex; flex-direction: column; backdrop-filter: blur(8px);
}
#messages { flex: 1; overflow-y: auto; padding: 10px; }
.msg { margin-bottom: 8px; padding: 7px 10px; border-radius: 10px; max-width: 92%; }
.msg.user { background: #2a3a2a; margin-left: auto; }
.msg.uni { background: #1f2a36; }
#composer { display: flex; gap: 6px; padding: 8px; border-top: 1px solid rgba(255,255,255,.1); }
#input { flex: 1; resize: none; height: 38px; border-radius: 8px; border: 0; background: rgba(0,0,0,.35); color: #e8edf2; padding: 8px; font: inherit; }
#sendBtn { width: 40px; border: 0; border-radius: 8px; background: #c4e534; color: #0f1419; cursor: pointer; }

/* D-08: аватар справа у кромки */
#avatar {
  position: absolute; right: 8px; bottom: 8px; width: 180px; z-index: 8; pointer-events: none;
}
#avatarImg { width: 100%; filter: drop-shadow(0 4px 10px rgba(0,0,0,.4)); transition: transform .2s; }
#avatar.speaking #avatarImg { transform: scale(1.03); }
#avatar.thinking #avatarImg { transform: rotate(-2deg); }
#bubble {
  position: absolute; top: -10px; left: -10px; right: -10px;
  background: rgba(20,26,34,.92); border: 1px solid rgba(255,255,255,.2);
  border-radius: 10px; padding: 6px 9px; font-size: 12px;
}

/* D-12: индикатор наблюдения */
#obsIndicator {
  position: absolute; bottom: 8px; left: 50%; transform: translateX(-50%);
  background: rgba(255,107,107,.85); color: #fff; padding: 3px 10px; border-radius: 10px; font-size: 11px; z-index: 11;
}

/* D-11: настройки */
#settings {
  position: absolute; top: 52px; right: 8px; width: 240px; z-index: 12;
  background: rgba(16,21,27,.95); border: 1px solid rgba(255,255,255,.15);
  border-radius: 12px; padding: 12px; display: flex; flex-direction: column; gap: 8px;
}
#settings h3 { font-size: 13px; color: #b3c0cf; }
#settings label { display: flex; flex-direction: column; gap: 3px; font-size: 12px; color: #cfd8e2; }
#settings select, #settings input[type=range] { width: 100%; }
#saveSettings { margin-top: 4px; background: #c4e534; color: #0f1419; border: 0; border-radius: 8px; padding: 7px; cursor: pointer; }
.hidden { display: none !important; }
.recording { outline: 2px solid #ff6b6b; }
