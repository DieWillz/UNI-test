# === UNI .gitignore (CLEAN-SLATE, 2026-08-13) ===

# --- Required by GIT REINIT directive ---
node_modules/
__pycache__/
*.pyc
*.pyo
*.pyd
.env
config.yaml
uni/config.yaml
*.log
STOP.txt
.uni-logs/
downloads/
runtime/downloads/

# Large binary assets — never commit (kept locally / snapshot only)
assets/*.vrm
uni/desktop/assets/*.vrm
*.onnx
*.onnx.json
*.pt
*.bin

# Old / duplicate trees (reference only, not canonical) — ignore entirely
UNI-mcp-server/
agents/

# --- Existing useful rules (preserved) ---
*.py[cod]
*.egg-info/
.pytest_cache/

# Windows Mark-of-the-Web
*.Zone.Identifier

# Browser profile (auth/cookies/local storage) — never in git
.uni-browser-profile/

# Runtime logs / samples / screenshots
.uni-voice-samples/
screenshots/
memory/
Telegram/

# Stale TOP-LEVEL duplicates of the package (NOT uni/ subdirs)
/backup/
/Claude/
/Uni-Claude/
/Uni-DeepSeek/
/Uni-OpenCode/
/uni/backup/
/uni/Claude/
/uni/uni/
/capabilities/
/tools/
/roles/
/config.py
/uni.py
